# Copy to .env and fill in your values. .env is gitignored — never commit it.

# ============================ CONTENT FACTORY ============================
# HotClip (https://github.com/xixihhhh/hotclip) does the clipping, editing
# (9:16 reframe, -14 LUFS), and word-synced dynamic captions locally.

# HotClip's 24/7 watch folder (HotClip app -> Settings). The watcher drops
# every new downloaded source video here.
HOTCLIP_WATCH_DIR=hotclip-watch

# HotClip's export directory (where finished clips + covers + .post.txt
# appear). The watcher picks them up here and queues them for publishing.
HOTCLIP_EXPORT_DIR=hotclip-exports

# A clip file must be this old before it is treated as finished (avoids
# grabbing a clip HotClip is still writing).
HOTCLIP_MIN_CLIP_AGE_SECONDS=90

# ============================ DISCOVERY ============================
# One channel per line in channels.txt; new uploads are found automatically.
CHANNELS_FILE=channels.txt
CHANNEL_SCAN_MAX_VIDEOS=5
CHANNEL_SCAN_INTERVAL_MINUTES=60

# Manual one-off queue (optional).
LINKS_FILE=links.txt
WORK_DIR=work
DATABASE_PATH=work/jobs.db
DOWNLOADED_LINKS_LOG=work/downloaded-links.log
LINKS_POLL_SECONDS=30

# ============================ SCHEDULER ============================
# Local 24h times. Plain "08:00,20:30" = daily; "mon=08:00;fri=08:00,21:30"
# = per weekday. Every slot uploads *_UPLOADS_PER_SLOT clips; missed or
# empty slots keep their credit and catch up automatically.
SCHEDULE_TIMEZONE=Asia/Kolkata

# YouTube: 3 slots/day x 2 uploads = 6/day (fits the default 10,000-unit
# YouTube API quota, which covers ~6 uploads/day).
YOUTUBE_SCHEDULE_TIMES=mon=07:30,13:00,20:30;tue=07:30,13:00,20:30;wed=07:30,13:00,20:30;thu=07:30,13:00,20:30;fri=07:30,13:00,21:30;sat=08:30,13:30,21:30;sun=08:30,13:30,21:30
YOUTUBE_UPLOADS_PER_SLOT=2

# Instagram: 2 slots/day x 10 uploads.
INSTAGRAM_SCHEDULE_TIMES=mon=08:00,20:30;tue=08:00,19:30;wed=12:00,20:30;thu=08:00,19:30;fri=12:00,20:30;sat=10:00,19:30;sun=10:30,19:30
INSTAGRAM_UPLOADS_PER_SLOT=10

# Facebook: 2 slots/day x 10 uploads.
FACEBOOK_SCHEDULE_TIMES=mon=09:00,20:00;tue=09:00,19:30;wed=12:00,20:00;thu=09:00,19:30;fri=12:00,20:30;sat=10:00,19:30;sun=10:30,19:00
FACEBOOK_UPLOADS_PER_SLOT=10

# ============================ STATUS PANEL ============================
# Live dashboard showing everything the bot does — running state, today's
# uploads vs what each platform is owed, slot credits, every discovery /
# delivery / publish with links ("what, when, where"), and the queue.
# Starts automatically with main.py; open http://localhost:8000 in a browser.
# If the port is busy the next free one is chosen and printed. Set
# STATUS_PANEL_ENABLED=false to turn it off.
STATUS_PANEL_ENABLED=true
STATUS_PANEL_HOST=127.0.0.1
STATUS_PANEL_PORT=8000
# Seconds without a watcher heartbeat before the badge shows STALE.
# Local default 120; the cloud workflow uses 2700 (15-min runs + delays).
STATUS_STALE_AFTER_SECONDS=120

# ============================ HASHTAGS ============================
# Every upload gets the ordered hashtag block from HASHTAGS_FILE appended
# automatically, from the first tag down, as many as each platform allows:
# Instagram 30/caption (its hard cap), YouTube 59/description (+ the #Shorts
# the uploader adds itself = the 60 YouTube allows), Facebook the whole list.
# Tags already in a clip's HotClip copy are never duplicated.
HASHTAGS_ENABLED=true
HASHTAGS_FILE=hashtags.txt
# 0 = no cap. Values above the platform caps are rejected on startup.
HASHTAGS_YOUTUBE_MAX=59
HASHTAGS_INSTAGRAM_MAX=30
HASHTAGS_FACEBOOK_MAX=0

# ============================ PLATFORMS ============================
UPLOAD_YOUTUBE=false
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

UPLOAD_INSTAGRAM=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v26.0

UPLOAD_FACEBOOK=true
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_LIMIT_COOLDOWN_HOURS=24

CHANNEL_CONFIG_FILE=channels.toml

# YouTube download login (only if YouTube asks to "confirm you're not a bot").
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_BROWSER_PROFILE=
YTDLP_COOKIE_FILE=

# Delete a clip's MP4 after it is published on every enabled platform.
# Default off: HotClip exports are kept on disk.
DELETE_UPLOADED_CLIPS=false

# This must be true. Only process videos you own or are licensed to reuse.
RIGHTS_ACKNOWLEDGED=false
