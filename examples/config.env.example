# Naveed configuration example.
#
# Copy this to ~/.naveed/config.env (or run `python -m naveed --setup`) and edit.
# Every value can also be given as an environment variable prefixed with NAVEED_,
# for example NAVEED_CAPTURE_INTERVAL=1.0, and CLI flags override both.

# --- the small LLM that decides what to click -------------------------------
# Any OpenAI-compatible endpoint works. Pick ONE of the blocks below.

# A) OpenAI (needs a key, best quality/price for small vision models)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# B) OpenRouter (one key, many cheap vision models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen2.5-vl-7b-instruct
# LLM_API_KEY=sk-or-...

# C) A local model (no key, nothing leaves the machine)
# LLM_BASE_URL=http://127.0.0.1:11434/v1     # Ollama
# LLM_MODEL=qwen2.5vl:7b

LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=700
LLM_TIMEOUT=45

# --- the floating mascot ----------------------------------------------------
# Where it appears: below_camera (default, centred under the webcam bezel),
# middle, top, bottom, top_left, top_right, bottom_right.
OVERLAY_ANCHOR=below_camera
OVERLAY_REMEMBER_POSITION=true  # come back where you dragged it last time
OVERLAY_SIZE=168              # mascot size in pixels
OVERLAY_ALWAYS_ON_TOP=true
OVERLAY_HOTKEY=ctrl+alt+space # global click-to-talk shortcut
OVERLAY_TRAY=true
OVERLAY_SHOW_PANEL_ON_START=true

# --- the browser front end --------------------------------------------------
# The same bot, openable at http://127.0.0.1:8765 — a real text box, a scrollback
# of what it did, and a way to reach it from another machine (use host 0.0.0.0,
# and Naveed then requires the token it prints on startup).
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_OPEN_BROWSER=false
WEB_ENABLED=true
# Require the token printed at startup when WEB_HOST is not loopback. Leave this
# on unless you are behind a tunnel or on a private network you control.
WEB_TOKEN=true

# --- watching the screen ----------------------------------------------------
CAPTURE_INTERVAL=2.0          # seconds between checks while the screen changes
CAPTURE_IDLE_INTERVAL=6.0     # seconds between checks while nothing happens
CAPTURE_TARGET=active_window  # active_window | primary
CAPTURE_SAVE_FRAMES=true      # keep changed frames in ~/.naveed/screenshots
CAPTURE_MAX_CAPTURES=100      # oldest frames are pruned automatically

# --- safety -----------------------------------------------------------------
SAFETY_CONFIRM_DESTRUCTIVE=true  # ask before delete/shutdown/purchase-ish acts
SAFETY_ALLOW_SHELL=false         # shell actions are off unless you opt in
SAFETY_DRY_RUN=false             # true = show what it would do, do nothing

# --- offline voice ----------------------------------------------------------
VOICE_STT=auto                 # auto | faster_whisper | vosk | none
VOICE_TTS=auto                 # auto | piper | pyttsx3 | none
VOICE_WHISPER_MODEL=base.en
VOICE_PIPER_VOICE=             # a .onnx voice, or leave empty for the default
VOICE_SILENCE_SECONDS=1.0      # how long a pause ends your sentence

# --- the task loop ----------------------------------------------------------
AGENT_MAX_STEPS=18
AGENT_MAX_TASK_SECONDS=240
AGENT_USE_OCR=true

# --- editing and taught apps (knowledge packs) -------------------------------
# Naveed can change text that is already on screen (read the field, change it,
# write it back, read it again to confirm) — see docs/EDITING.md.
SKILLS_ENABLED=true             # taught apps / knowledge packs
SKILLS_INJECT=true              # put what it knows about the app in front into the prompt
SKILLS_MAX_CONTEXT_CHARS=3600   # how much of that knowledge fits in one prompt
SKILLS_DIRECTORY=               # empty -> ~/.naveed/skills (learned routines live here)
SKILLS_TEACH_HOTKEY=ctrl+alt+t  # start/stop recording a demonstration

# The Polarion ALM pack (see docs/POLARION.md). Everything here is optional: with
# no base URL the REST tools are simply not offered and Naveed drives the UI.
SKILLS_POLARION_BASE_URL=       # e.g. https://alm.example.com
SKILLS_POLARION_TOKEN=          # a personal access token
SKILLS_POLARION_PROJECT=        # default project for bare ids like 1042
SKILLS_ALLOW_API=true           # allow read-only REST tools
SKILLS_ALLOW_API_WRITES=false   # allow REST tools that change data (asks first)
# SKILLS_POLARION_ENDPOINTS=comments:/polarion/rest/v1/projects/{project}/workitems/{id}/comments
